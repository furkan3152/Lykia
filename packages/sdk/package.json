{
  "name": "@lykia/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Lykia API on Arc Network: intents, the Fence, agents, Circle, the ecosystem and white-label projects, as one client or modular subpaths.",
  "keywords": [
    "lykia",
    "arc",
    "circle",
    "usdc",
    "stablecoin",
    "agents",
    "intents",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://lykia-akdogan1.vercel.app/build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/lykia.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./intents": {
      "types": "./dist/intents.d.ts",
      "import": "./dist/intents.js"
    },
    "./fence": {
      "types": "./dist/fence.d.ts",
      "import": "./dist/fence.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./circle": {
      "types": "./dist/circle.d.ts",
      "import": "./dist/circle.js"
    },
    "./ecosystem": {
      "types": "./dist/ecosystem.d.ts",
      "import": "./dist/ecosystem.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@lykia/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
