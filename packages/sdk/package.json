{
  "name": "@lykia/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Lykia API on Arc Network: intents, the Fence, agents, Circle, the ecosystem and white-label projects, as one client or modular subpaths.",
  "keywords": [
    "lykia",
    "arc",
    "circle",
    "usdc",
    "stablecoin",
    "agents",
    "intents",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://lykiaai.com/forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/Lykia.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/furkan3152/Lykia/issues"
  },
  "author": "Furkan Akdogan (https://github.com/furkan3152)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./intents": {
      "types": "./dist/intents.d.ts",
      "import": "./dist/intents.js"
    },
    "./fence": {
      "types": "./dist/fence.d.ts",
      "import": "./dist/fence.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./circle": {
      "types": "./dist/circle.d.ts",
      "import": "./dist/circle.js"
    },
    "./ecosystem": {
      "types": "./dist/ecosystem.d.ts",
      "import": "./dist/ecosystem.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "import": "./dist/projects.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./aggregator": {
      "types": "./dist/aggregator.d.ts",
      "import": "./dist/aggregator.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "import": "./dist/integrations.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "import": "./dist/platform.js"
    },
    "./generated": {
      "types": "./dist/generated/openapi.d.ts",
      "import": "./dist/generated/openapi.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    },
    "./payouts": {
      "types": "./dist/payouts.d.ts",
      "import": "./dist/payouts.js"
    },
    "./invoices": {
      "types": "./dist/invoices.d.ts",
      "import": "./dist/invoices.js"
    },
    "./automations": {
      "types": "./dist/automations.d.ts",
      "import": "./dist/automations.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@lykia/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
