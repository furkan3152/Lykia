{
  "name": "@lykia/core",
  "version": "0.1.0",
  "description": "Lykia core: Arc networks, verified contracts and tokens, the venue registry, the intent graph, the Fence, Tags, white-label projects and the Outrun. Pure TypeScript, no I/O.",
  "keywords": [
    "lykia",
    "arc",
    "circle",
    "usdc",
    "fence",
    "intents",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://lykia-akdogan1.vercel.app/mint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/lykia.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
