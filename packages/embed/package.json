{
  "name": "@lykia/embed",
  "version": "0.1.0",
  "description": "Lykia as web components: <lykia-assistant>, <lykia-swap> and more. One script tag, sandboxed iframes, the project's brand, DOM events.",
  "keywords": [
    "lykia",
    "arc",
    "circle",
    "usdc",
    "web-components",
    "embed",
    "widget",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://lykia-akdogan1.vercel.app/mint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furkan3152/lykia.git",
    "directory": "packages/embed"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/lykia-embed.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/lykia-embed.js",
  "jsdelivr": "./dist/lykia-embed.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./script": "./dist/lykia-embed.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
