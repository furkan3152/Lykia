{
  "name": "@lykia/web",
  "private": true,
  "version": "0.1.0",
  "description": "The Lykia web app: Ask Lyko, The Fold, The Forge and the League, on the Mosaic design system.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "test": "node --import tsx --test \"src/**/__tests__/*.test.ts\"",
    "contrast": "node --import tsx scripts/contrast/run.ts",
    "languages": "node --import tsx scripts/pages/language.ts"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "1.0.16",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@fontsource/pixelify-sans": "5.2.5",
    "@fontsource/silkscreen": "5.2.5",
    "@lykia/core": "0.1.0",
    "@lykia/embed": "0.1.0",
    "@lykia/sdk": "0.1.0",
    "@lykia/widget": "0.1.0",
    "@tanstack/react-query": "5.104.1",
    "buffer": "6.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.57.4",
    "wagmi": "2.19.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.18",
    "tailwindcss": "3.4.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
