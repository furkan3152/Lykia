{
  "name": "@lykia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lykia API: Arc data, the Flock, intents and Outruns, the Fence, Tags, Scent, the Lyko agent, MCP and x402.",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/__tests__/*.test.ts\"",
    "smoke": "tsx src/scripts/smoke.ts",
    "smoke:e2e": "tsx src/scripts/e2e.ts",
    "prove": "tsx src/scripts/prove.ts",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@lykia/core": "0.1.0",
    "@modelcontextprotocol/server": "2.3.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "pg": "8.16.3",
    "viem": "2.57.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
