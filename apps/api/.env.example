# Lykia API environment. Every variable is optional; the defaults serve Arc testnet read-only.

# Listen address
# NODE_ENV=production turns on the production checks (exact https CORS origins, a required session secret)
PORT=3002
HOST=0.0.0.0

# testnet or mainnet: the default Arc environment when a request does not say
LYKIA_MODE=testnet

# Extra CORS origins, comma-separated exact https origins (localhost is allowed outside production)
LYKIA_WEB_ORIGIN=

# The domain League cities run under as subdomains (pay.<root>, agents.<root>); see docs/platform/city-domains.md
LYKIA_ROOT_DOMAIN=

# Postgres for intents, claims, Tag cards and spend counters (in-memory without it).
# DATABASE_URL and POSTGRES_URL are read as fallbacks; LYKIA_DATABASE_URL wins.
LYKIA_DATABASE_URL=

# Extra RPC endpoints, comma-separated; tried before Arc's public RPC
ARC_MAINNET_RPC_URL=
ARC_TESTNET_RPC_URL=

# Lyko agent: with a key and a model id, /v1/agent/chat answers with the model and Lykia's tools; without them, the deterministic reader answers
ANTHROPIC_API_KEY=
LYKIA_AGENT_MODEL=
# Model rounds per agent per turn, output tokens per model call
LYKIA_AGENT_MAX_STEPS=6
LYKIA_AGENT_MAX_TOKENS=4096
# Global cap on model calls per UTC day (shared store); past it the deterministic reader answers
# LYKIA_MODEL_DAILY_CALLS=2000
# Per-IP requests per minute on chat and /v1/ai/*, counted across instances
# LYKIA_RATE_LIMIT_SHARED=20

# Sign-in and developer platform (LYKIA_SESSION_SECRET below also hashes API keys and seals webhook secrets)
# Extra SIWE domains (host[:port]) and admin addresses, comma-separated
LYKIA_SIWE_DOMAINS=
LYKIA_ADMIN_ADDRESSES=
# The first admin address owns the League's official cities (npm run seed:league -w @lykia/api, or Letoon)

# Circle StableFX RFQ credentials for the StableFX taker endpoints (/v1/circle/stablefx/*); fx steps in a plan route on chain either way
STABLEFX_API_KEY=

# 0x Swap API key: with it, the 0x aggregator (AllowanceHolder) becomes a routable swap venue; without it 0x stays read-only
ZEROX_API_KEY=

# x402 pay-per-call in USDC on Arc. PAY_TO defaults to the fee recipient; "off" disables the paid routes.
# ERC-8354 policy verdicts: the guard address that answers ValidationRegistry requests (signs with its own key; the server never signs).
LYKIA_GUARD_ADDRESS=
LYKIA_X402_PAY_TO=
LYKIA_X402_PRICE_USDC=0.01
# Defaults to Circle's x402 facilitator (settles with CIRCLE_API_KEY); "off" verifies payments without settling
LYKIA_X402_FACILITATOR_URL=
# Circle developer-controlled EOA wallet that is the x402 payTo; it signs the seller proof Circle's facilitator asks for
# CIRCLE_X402_SELLER_WALLET_ID=
# Mainnet beta cap while the contracts are unaudited: per step / per day per owner, or "off"
LYKIA_BETA_CAP_USD=1000/5000

# Logging and proxies (log level: debug, info, warn, error or silent; trust proxy: 0-3 hops in front of the API)
LYKIA_LOG_LEVEL=
LYKIA_TRUST_PROXY=
LYKIA_SESSION_SECRET=

# Per-IP requests per minute
LYKIA_RATE_LIMIT_DEFAULT=600
LYKIA_RATE_LIMIT_HEAVY=60
LYKIA_RATE_LIMIT_AUTH=20

# Protocol fee per value-moving step: 100 = 1% (max 300), paid to the recipient in the same transaction.
# LYKIA_FEE_BPS=100
# LYKIA_FEE_RECIPIENT=0x8c5281055b197443ff01dbbdfbf29fd63946ca1e
# Per-kind fees in bps, and per-plan overrides for API customers (see docs/fees.md)
# LYKIA_FEE_SCHEDULE={"transfer":0,"swap":30}
# LYKIA_FEE_SCHEDULE_PLANS={"scale":{"transfer":0}}

# Circle platform (all optional; keyed features say what they need when unset)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# Opt-in: create Circle developer-controlled wallets for signed-in users and execute payouts from them.
# The server then signs those wallets' transactions with the entity secret above. Off unless "true".
# LYKIA_CIRCLE_SERVER_WALLETS=true

# Telegram notifications named in owner profiles
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# Optional gas-only keeper: executes due conditional orders already signed by their owners
# LYKIA_KEEPER_PRIVATE_KEY=
# Bearer secret for /cron/* and POST /v1/reconcile/tick
# CRON_SECRET=

# Build commit kept in the runtime config (Render sets RENDER_GIT_COMMIT on its own)
# LYKIA_BUILD_COMMIT=
